{
  "version": 2,
  "writer": {
    "kind": "local-launchd",
    "id": "alambic-nightly",
    "command": "alambic nightly --push",
    "installer": "alambic setup --schedule [HH:MM]",
    "label": "dev.alambic.<handle>.nightly",
    "default_time": "05:15",
    "mode": "apply-all",
    "max_actions": 12,
    "max_freeform_per_run": 3,
    "scope": [
      "kb/",
      "ref/",
      "_meta/enrich-ledger.json",
      "docs/inbox/ deletions"
    ],
    "manual_fallback": ".github/workflows/alambic-sidekick-daily.yml",
    "laptop_default": "dry-run",
    "note": "Single kb writer per vault: the machine that holds the sessions. Other machines git pull. Session notes need a human review receipt before they reach kb/."
  },
  "non_writers": [
    {
      "kind": "github-actions",
      "id": "ci",
      "workflow": ".github/workflows/ci.yml",
      "writes_kb": false,
      "role": "hygiene-pulse"
    },
    {
      "kind": "local-script",
      "id": "attention-daily",
      "path": "_meta/bin/attention-daily-grok.sh",
      "writes_kb": false,
      "sidekick_apply_default": false,
      "role": "optional-local-collect"
    },
    {
      "kind": "local-script",
      "id": "youtube-weekly-collector",
      "path": "_meta/youtube-weekly-collector.sh",
      "writes_kb": false,
      "scope": [
        "docs/youtube-weekly-runs/"
      ],
      "role": "source-only"
    }
  ],
  "legacy_writers": [
    {
      "kind": "codex-automation",
      "id": "daily-alambic-conversation-kb",
      "expected_active": false,
      "reason": "superseded by the local alambic-nightly LaunchAgent"
    },
    {
      "kind": "codex-automation",
      "id": "weekly-youtube-knowledge-radar",
      "expected_active": false,
      "reason": "Codex automation.toml is not a live writer; youtube-weekly-collector.sh is source-only"
    }
  ],
  "runtime_state": {
    "directory": "${ALAMBIC_STATE_DIR:-$XDG_STATE_HOME/alambic}",
    "directory_mode": "0700",
    "file_mode": "0600"
  }
}
