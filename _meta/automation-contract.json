{
  "version": 2,
  "writer": {
    "kind": "github-actions",
    "id": "alambic-sidekick-daily",
    "workflow": ".github/workflows/alambic-sidekick-daily.yml",
    "expected_status": "ACTIVE",
    "schedule": "15 5 * * *",
    "schedule_gate": "vars.ALAMBIC_SIDEKICK_SCHEDULE == 'true'",
    "dispatch": true,
    "mode": "apply-all",
    "max_actions": 12,
    "max_freeform_per_run": 3,
    "scope": [
      "kb/",
      "docs/inbox/ai/promote-ready/"
    ],
    "laptop_default": "dry-run",
    "note": "Single kb writer. Laptops git pull. Local sidekick stays dry-run so it cannot race CI."
  },
  "non_writers": [
    {
      "kind": "github-actions",
      "id": "ci",
      "workflow": ".github/workflows/ci.yml",
      "writes_kb": false,
      "role": "hygiene-pulse"
    },
    {
      "kind": "local-script",
      "id": "attention-daily",
      "path": "_meta/bin/attention-daily-grok.sh",
      "writes_kb": false,
      "sidekick_apply_default": false,
      "role": "optional-local-collect"
    },
    {
      "kind": "local-script",
      "id": "youtube-weekly-collector",
      "path": "_meta/youtube-weekly-collector.sh",
      "writes_kb": false,
      "scope": [
        "docs/youtube-weekly-runs/"
      ],
      "role": "source-only"
    }
  ],
  "legacy_writers": [
    {
      "kind": "codex-automation",
      "id": "daily-alambic-conversation-kb",
      "expected_active": false,
      "reason": "superseded by GitHub Actions alambic-sidekick-daily"
    },
    {
      "kind": "codex-automation",
      "id": "weekly-youtube-knowledge-radar",
      "expected_active": false,
      "reason": "Codex automation.toml is not a live writer; youtube-weekly-collector.sh is source-only"
    }
  ],
  "runtime_state": {
    "directory": "$XDG_STATE_HOME/alambic",
    "directory_mode": "0700",
    "file_mode": "0600"
  }
}
