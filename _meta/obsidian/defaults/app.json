{
  "alwaysUpdateLinks": true,
  "newFileLocation": "folder",
  "newFileFolderPath": "docs/inbox/manual",
  "attachmentFolderPath": "docs/assets",
  "useMarkdownLinks": false,
  "newLinkFormat": "shortest",
  "showLineNumber": true,
  "strictLineBreaks": false,
  "showFrontmatter": true,
  "foldHeading": true,
  "foldIndent": true,
  "showIndentGuide": true,
  "readableLineLength": true,
  "strictHtml": false,
  "promptDelete": true,
  "trashOption": "local",
  "showUnsupportedFiles": false,
  "userIgnoreFilters": [
    "_meta/tests/**",
    "_meta/lib/**",
    "_meta/*.mjs",
    "_meta/*.sh",
    "_meta/*.json",
    ".git/**",
    ".workflow/**",
    "docs/**/txt/**",
    "docs/**/manifest.tsv",
    "docs/**/coverage.tsv",
    "docs/**/INDEX.txt",
    "docs/inbox/ai/**",
    "docs/youtube-weekly-runs/**",
    "docs/plan/**",
    "docs/projects/**"
  ]
}
