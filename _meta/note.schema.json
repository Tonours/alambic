{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alambic:note.schema.json",
  "title": "alambic durable note frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status",
    "summary",
    "created",
    "updated",
    "tags",
    "sources"
  ],
  "properties": {
    "type": {
      "enum": [
        "finding",
        "incident",
        "adr",
        "reference",
        "synthesis"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "stale",
        "accepted",
        "superseded",
        "draft"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "promoted_from": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    }
  }
}
