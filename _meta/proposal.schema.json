{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alambic:proposal.schema.json",
  "title": "alambic shadow distillation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "action", "target", "source_refs", "trust", "rationale", "preimage_sha256", "patch"],
  "properties": {
    "version": { "const": 1 },
    "action": { "enum": ["create", "update", "noop"] },
    "target": { "type": "string" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "trust": { "enum": ["trusted-local", "untrusted-session-data", "untrusted-public"] },
    "rationale": { "type": "string", "minLength": 1 },
    "preimage_sha256": { "type": "string" },
    "patch": { "type": "string" }
  }
}
